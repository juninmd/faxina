{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Faxina",
  "version": "../package.json",
  "identifier": "io.github.juninmd.faxina",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Faxina",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0e1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Limpeza visual de disco: caches, duplicatas e mapa de espa\u00c3\u00a7o",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyOUZDNDkxRkE5MEQ0OTIKUldTUzFKRDZrY1Nmb2w5N0RUSWx0TFFQVUJwaUl4dWRPQjdDVGE5NXJ3YzdCRlZWcjIyeitZY0wK",
      "endpoints": [
        "https://github.com/juninmd/faxina/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
